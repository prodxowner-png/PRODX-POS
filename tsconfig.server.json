{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "scripts/bootstrap-first-tenant.ts",
    "scripts/bootstrap-first-tenant.test.ts"
  ]
}
