# GEMINI_API_KEY: Legacy AI Studio configuration for existing frontend tooling.
# Never expose provider secrets to browser bundles in production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google Gemini provider (server-side only).
# API key must be configured as a deployment secret and must never be committed.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_MS="30000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
